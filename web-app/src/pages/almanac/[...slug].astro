---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const almanac = await getCollection('almanac');
  const paths: any[] = [];
  
  // 1. Dynamic route for every Almanac entry (both full id and flat basename id)
  almanac.forEach(entry => {
    // Full id: "genesis/characters/emily-cartwright" (Astro uses id instead of slug)
    paths.push({
      params: { slug: entry.id },
      props: { entry, type: 'entry' }
    });
    
    // Flat slug: "emily-cartwright"
    const parts = entry.id.split('/');
    const flatSlug = parts[parts.length - 1];
    if (flatSlug && flatSlug !== entry.id) {
      paths.push({
        params: { slug: flatSlug },
        props: { entry, type: 'entry' }
      });
    }
  });
  
  // 2. Dynamic route for categories
  const categories = ['characters', 'factions', 'locations', 'concepts', 'items', 'base', 'timeline'];
  categories.forEach(cat => {
    paths.push({
      params: { slug: cat },
      props: { categoryName: cat, type: 'category' }
    });
  });
  
  return paths;
}

const { slug } = Astro.params;
const { entry, categoryName, type } = Astro.props;

// Fetch all entries for sidebars and indexes
const allEntries = await getCollection('almanac');

const base = import.meta.env.BASE_URL;

// Define sidebar items based on what we are viewing
let sidebarTitle = "Almanac";
let sidebarItems: Array<{ label: string; href: string; active?: boolean }> = [
  { label: "All Entries", href: `${base}/almanac` },
  { label: "Characters", href: `${base}/almanac/characters`, active: categoryName === 'characters' },
  { label: "Factions", href: `${base}/almanac/factions`, active: categoryName === 'factions' },
  { label: "Locations", href: `${base}/almanac/locations`, active: categoryName === 'locations' },
  { label: "Concepts", href: `${base}/almanac/concepts`, active: categoryName === 'concepts' },
  { label: "Items", href: `${base}/almanac/items`, active: categoryName === 'items' }
];

// If we are viewing a specific entry, update sidebar to list entries in the same category
let currentCategory = '';
let RenderedContent: any = null;

if (type === 'entry' && entry) {
  currentCategory = entry.data.category;
  const sameCategoryEntries = allEntries.filter(
    e => e.data.category.toLowerCase() === currentCategory.toLowerCase() && e.data.scenario === entry.data.scenario
  );
  
  sidebarTitle = currentCategory;
  sidebarItems = sameCategoryEntries.map(e => {
    const parts = e.id.split('/');
    const flat = parts[parts.length - 1];
    return {
      label: e.data.title,
      href: `${base}/almanac/${flat}`,
      active: e.id === entry.id
    };
  });
  
  const rendered = await render(entry);
  RenderedContent = rendered.Content;
}

// If we are viewing a category, get all entries in that category
let categoryEntries: typeof allEntries = [];
if (type === 'category' && categoryName) {
  categoryEntries = allEntries.filter(
    e => e.data.category.toLowerCase() === categoryName.toLowerCase()
  );
}
---

<MainLayout 
  title={type === 'entry' && entry ? entry.data.title : (categoryName ? categoryName.charAt(0).toUpperCase() + categoryName.slice(1) : "Almanac")} 
  activeTab="almanac"
  showSidebar={true}
  sidebarTitle={sidebarTitle}
  sidebarItems={sidebarItems}
>
  <a href={`${base}/almanac`} class="back-link">Almanac</a>

  {type === 'entry' && entry && RenderedContent && (
    <article>
      <header class="page-header" style="border-bottom: 1px solid var(--border-color); padding-bottom: 20px; margin-bottom: 28px;">
        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
          {entry.data.category} · {entry.data.scenario}
        </div>
        <h1 style="margin: 0; color: var(--accent);">
          {entry.data.title}
        </h1>
      </header>
      
      <!-- Info Sheet (Metadata) -->
      <div class="info-sheet">
        <div class="info-row-label">Category</div>
        <div class="info-row-value">{entry.data.category}</div>
        
        <div class="info-row-label">Scenario</div>
        <div class="info-row-value">{entry.data.scenario}</div>
        
        {entry.data.aliases && entry.data.aliases.length > 0 && (
          <div class="info-row-label">Aliases</div>
          <div class="info-row-value">
            {entry.data.aliases.map(alias => (
              <span class="badge">{alias}</span>
            ))}
          </div>
        )}
        
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="info-row-label">Tags</div>
          <div class="info-row-value">
            {entry.data.tags.map(tag => (
              <span class="badge" style="color: var(--text-secondary);">#{tag}</span>
            ))}
          </div>
        )}
      </div>

      <!-- Core Entry Body -->
      <div class="story-reader">
        <RenderedContent />
      </div>
    </article>
  )}

  {type === 'category' && categoryName && (
    <div>
      <div class="page-header">
        <h1>{categoryName.charAt(0).toUpperCase() + categoryName.slice(1)}</h1>
        <p class="page-subtitle">
          {categoryEntries.length} {categoryEntries.length === 1 ? 'entry' : 'entries'} in this category.
        </p>
      </div>

      {categoryEntries.length === 0 ? (
        <p style="color: var(--text-secondary); font-size: 0.9rem;">No entries found in this category.</p>
      ) : (
        <ul class="content-list">
          {categoryEntries.map(e => {
            const parts = e.id.split('/');
            const flat = parts[parts.length - 1];
            return (
              <li class="content-list-item">
                <a href={`${base}/almanac/${flat}`}>
                  {e.data.title}
                </a>
                {e.data.description && (
                  <div class="list-meta">{e.data.description}</div>
                )}
              </li>
            );
          })}
        </ul>
      )}
    </div>
  )}
</MainLayout>
