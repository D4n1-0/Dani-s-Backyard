---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { scenarios, getScenario } from '../../lib/scenarios';

export async function getStaticPaths() {
  return Object.keys(scenarios).map(slug => ({ params: { scenario: slug } }));
}

const { scenario } = Astro.params;
const base = import.meta.env.BASE_URL;
const currentMeta = getScenario(scenario);

if (!currentMeta) return Astro.redirect(`${base}/`);

const allEntries = await getCollection('almanac');

const scenarioEntries = allEntries.filter(
  entry => entry.data.scenario.toLowerCase() === scenario
);

const categories = ['Characters', 'Factions', 'Locations', 'Concepts', 'Items', 'Base', 'Timeline'];
const entriesByCategory = categories.reduce((acc, cat) => {
  acc[cat] = scenarioEntries.filter(
    entry => entry.data.category.toLowerCase() === cat.toLowerCase()
  );
  return acc;
}, {} as Record<string, typeof allEntries>);

const sidebarItems = categories
  .filter(cat => (entriesByCategory[cat] || []).length > 0)
  .map(cat => ({
    label: `${cat} (${entriesByCategory[cat].length})`,
    href: `#${cat.toLowerCase()}`,
    active: false,
  }));
---

<MainLayout
  title={`${currentMeta.title} - Almanac`}
  activeTab="almanac"
  showSidebar={true}
  sidebarTitle="Categories"
  sidebarItems={sidebarItems}
  scenario={scenario}
>
  <a href={`${base}/${scenario}`} class="back-link">Back to Hub</a>

  <div class="page-header">
    <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">
      {currentMeta.title} World Details
    </div>
    <h1>Almanac</h1>
    <p class="page-subtitle">
      Encyclopedia of characters, factions, locations, concepts, and lore for {currentMeta.title}.
    </p>
  </div>

  <div class="category-grid">
    {categories.map(cat => {
      const list = entriesByCategory[cat] || [];
      if (list.length === 0) return null;
      return (
        <a href={`#${cat.toLowerCase()}`} class="category-card">
          <span class="category-card-name">{cat}</span>
          <span class="category-card-count">{list.length} {list.length === 1 ? 'Entry' : 'Entries'}</span>
        </a>
      );
    })}
  </div>

  <div class="filter-tabs" id="almanac-filters">
    <button class="filter-tab active" data-filter="all">All</button>
    {categories
      .filter(cat => (entriesByCategory[cat] || []).length > 0)
      .map(cat => (
        <button class="filter-tab" data-filter={cat.toLowerCase()}>
          {cat} ({entriesByCategory[cat].length})
        </button>
      ))}
  </div>

  {categories.map(cat => {
    const list = entriesByCategory[cat] || [];
    if (list.length === 0) return null;

    return (
      <div
        id={cat.toLowerCase()}
        class="almanac-category"
        data-category={cat.toLowerCase()}
        style="margin-bottom: 40px; scroll-margin-top: 24px;"
      >
        <h2 class="section-heading">{cat}</h2>
        <ul class="content-list">
          {list.map(e => {
            const parts = e.id.split('/');
            const flat = parts[parts.length - 1];
            return (
              <li class="content-list-item">
                <div>
                  <a href={`${base}/almanac/${flat}`}>
                    {e.data.title}
                  </a>
                </div>
                {e.data.description && (
                  <div class="list-meta">{e.data.description}</div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    );
  })}
</MainLayout>

<script>
  // Almanac category filter tabs
  const tabs = document.querySelectorAll('#almanac-filters .filter-tab');
  const sections = document.querySelectorAll('.almanac-category');
  const categoryGrid = document.querySelector('.category-grid');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = (tab as HTMLElement).dataset.filter || 'all';
      tabs.forEach(t => t.classList.toggle('active', t === tab));

      sections.forEach(sec => {
        const cat = (sec as HTMLElement).dataset.category;
        if (filter === 'all' || cat === filter) {
          sec.classList.remove('hidden');
        } else {
          sec.classList.add('hidden');
        }
      });

      // Hide the quick-link grid when filtering to a single category
      if (categoryGrid) {
        (categoryGrid as HTMLElement).style.display = filter === 'all' ? '' : 'none';
      }
    });
  });
</script>
