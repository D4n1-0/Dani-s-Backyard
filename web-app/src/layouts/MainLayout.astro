---
import '../styles/global.css';
import LinkPreview from '../components/LinkPreview.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { getScenarioFromPath, getScenario } from '../lib/scenarios';

interface Props {
  title: string;
  activeTab?: 'home' | 'chapters' | 'almanac';
  showSidebar?: boolean;
  sidebarTitle?: string;
  sidebarItems?: Array<{ label: string; href: string; active?: boolean }>;
  scenario?: string;
}

const base = import.meta.env.BASE_URL;

const {
  title,
  activeTab = 'home',
  showSidebar = false,
  sidebarTitle = "Navigation",
  sidebarItems = [],
  scenario: scenarioProp
} = Astro.props;

// Detect scenario from props or path
const currentScenario = scenarioProp
  ? getScenario(scenarioProp)
  : getScenarioFromPath(Astro.url.pathname);

// Retheming based on current scenario
const themeStyles = currentScenario
  ? `--accent: ${currentScenario.accent}; --accent-rgb: ${currentScenario.accentRgb};`
  : '';

// Combine theme styles and background images with base path resolution
const fullStyles = `--bg-image-dark: url(${base}/images/Darkmode.jpg); --bg-image-light: url(${base}/images/Whitemode.jpg); ${themeStyles}`;
---

<!doctype html>
<html lang="en" style={fullStyles} data-scenario={currentScenario ? currentScenario.slug : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Initialization blocking script to prevent theme flash -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        document.documentElement.setAttribute('data-theme', storedTheme || 'dark');
      })();
    </script>

    <!-- SEO Meta Tags -->
    <title>{title} | Dani's Backyard</title>
    <meta name="description" content="A serialized story narrative and worldbuilding companion." />
  </head>
  <body class={activeTab === 'home' && !currentScenario ? 'is-root-home' : ''}>
    <div class="site-container">
      <!-- HEADER -->
      <header class="site-header">
        <div class="site-logo">
          <a href={base}>Dani's Backyard</a>
        </div>
        
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href={base} class={activeTab === 'home' ? 'active' : ''}>Home</a>
          <a href={currentScenario ? `${base}/${currentScenario.slug}/chapters` : `${base}/chapters`} class={activeTab === 'chapters' ? 'active' : ''}>Chapters</a>
          <a href={currentScenario ? `${base}/${currentScenario.slug}/almanac` : `${base}/almanac`} class={activeTab === 'almanac' ? 'active' : ''}>Almanac</a>
        </nav>

        <div class="header-controls">
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" title="Toggle Light/Dark Mode">
            <!-- Sun Icon (visible in dark mode) -->
            <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="M4.93 4.93l1.41 1.41"></path>
              <path d="M17.66 17.66l1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="M6.34 17.66l-1.41 1.41"></path>
              <path d="M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <!-- Moon Icon (visible in light mode) -->
            <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>

          <button class="hamburger-btn" id="hamburger-btn" aria-label="Toggle navigation" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </header>
      <!-- NAV PANEL (slide-in mobile drawer) -->
      <div class="nav-backdrop" id="nav-backdrop"></div>
      <nav class="nav-panel" id="nav-panel" aria-label="Mobile navigation">
        <a href={base} class={activeTab === 'home' ? 'active' : ''}>Home</a>
        <a href={currentScenario ? `${base}/${currentScenario.slug}/chapters` : `${base}/chapters`} class={activeTab === 'chapters' ? 'active' : ''}>Chapters</a>
        <a href={currentScenario ? `${base}/${currentScenario.slug}/almanac` : `${base}/almanac`} class={activeTab === 'almanac' ? 'active' : ''}>Almanac</a>
      </nav>

      <!-- MAIN CONTENT WRAPPER -->
      <div class={`main-wrapper ${!showSidebar ? 'no-sidebar' : ''}`}>
        {showSidebar && sidebarItems.length > 0 && (
          <aside class="sidebar">
            <h3>{sidebarTitle}</h3>
            <ul class="sidebar-list">
              {sidebarItems.map(item => (
                <li>
                  <a href={item.href} class={item.active ? 'active' : ''}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}

        <main>
          <slot />
        </main>
      </div>
    </div>

    <LinkPreview />
    <ImageLightbox />

    <script>
      // Hamburger menu toggle
      const hamburgerBtn = document.getElementById('hamburger-btn');
      const navPanel = document.getElementById('nav-panel');
      const navBackdrop = document.getElementById('nav-backdrop');

      function openNav() {
        hamburgerBtn?.classList.add('active');
        navPanel?.classList.add('open');
        navBackdrop?.classList.add('visible');
        hamburgerBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeNav() {
        hamburgerBtn?.classList.remove('active');
        navPanel?.classList.remove('open');
        navBackdrop?.classList.remove('visible');
        hamburgerBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      hamburgerBtn?.addEventListener('click', () => {
        const isOpen = navPanel?.classList.contains('open');
        if (isOpen) {
          closeNav();
        } else {
          openNav();
        }
      });

      navBackdrop?.addEventListener('click', closeNav);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeNav();
      });



      // Mermaid diagram renderer integration
      const mermaidBlocks = document.querySelectorAll('pre.language-mermaid, pre:has(code.language-mermaid), pre[data-language="mermaid"]');
      mermaidBlocks.forEach(block => {
        const codeElement = block.querySelector('code');
        const rawCode = codeElement ? codeElement.innerText : (block as HTMLElement).innerText;
        
        const div = document.createElement('div');
        div.className = 'mermaid';
        div.textContent = rawCode;
        block.parentNode?.replaceChild(div, block);
      });

      // Wrap tables in responsive container
      function wrapTables() {
        const tables = document.querySelectorAll('.story-reader table');
        tables.forEach(table => {
          if (table.parentNode && (table.parentNode as HTMLElement).classList.contains('table-container')) return;
          
          const wrapper = document.createElement('div');
          wrapper.className = 'table-container';
          table.parentNode?.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        });
      }

      wrapTables();
      document.addEventListener('astro:after-swap', wrapTables);

      // Theme toggle click handler
      function setupThemeToggle() {
        const toggleBtn = document.getElementById('theme-toggle');
        if (!toggleBtn) return;

        // Clean up any existing listeners just in case
        const newToggleBtn = toggleBtn.cloneNode(true);
        toggleBtn.parentNode?.replaceChild(newToggleBtn, toggleBtn);

        newToggleBtn.addEventListener('click', () => {
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
          const newTheme = currentTheme === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', newTheme);
          localStorage.setItem('theme', newTheme);
        });
      }

      setupThemeToggle();
      document.addEventListener('astro:after-swap', setupThemeToggle);
    </script>

    <!-- Load and Initialize Mermaid -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10.2.4/dist/mermaid.min.js"></script>
    <script is:inline>
      if (typeof mermaid !== 'undefined') {
        mermaid.initialize({
          startOnLoad: true,
          theme: 'dark',
          securityLevel: 'loose',
          flowchart: { useMaxWidth: true, htmlLabels: true }
        });
      }
    </script>
  </body>
</html>
