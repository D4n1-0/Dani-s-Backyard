---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allChapters = await getCollection('chapters');

const base = import.meta.env.BASE_URL;

// Sort by chapter number
const sortedChapters = allChapters.sort((a, b) => {
  const aNum = a.data.chapterNumber ?? 0;
  const bNum = b.data.chapterNumber ?? 0;
  return aNum - bNum;
});

// Group by scenario
const chaptersByScenario = sortedChapters.reduce((acc, ch) => {
  const scenario = ch.data.scenario;
  if (!acc[scenario]) acc[scenario] = [];
  acc[scenario].push(ch);
  return acc;
}, {} as Record<string, typeof allChapters>);
---

<MainLayout 
  title="Chapters" 
  activeTab="chapters"
>
  <a href={base} class="back-link">Home</a>
  
  <div class="page-header">
    <h1>Chapters</h1>
    <p class="page-subtitle">Read through the chronological logs of each scenario.</p>
  </div>

  {Object.keys(chaptersByScenario).length === 0 ? (
    <p style="color: var(--text-secondary); font-size: 0.9rem;">No chapters published yet.</p>
  ) : (
    Object.entries(chaptersByScenario).map(([scenario, list]) => (
      <div>
        <h2 class="section-heading">{scenario}</h2>
        <ul class="content-list">
          {list.map(chapter => {
            const parts = chapter.id.split('/');
            const flat = parts[parts.length - 1];
            return (
              <li class="content-list-item">
                <div>
                  <span class="list-number">CH {chapter.data.chapterNumber ?? '??'}</span>
                  <a href={`${base}/chapters/${flat}`}>
                    {chapter.data.title}
                  </a>
                </div>
                {chapter.data.releaseDate && (
                  <div class="list-meta">{chapter.data.releaseDate}</div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  )}
</MainLayout>
