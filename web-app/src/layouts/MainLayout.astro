---
import '../styles/global.css';
import LinkPreview from '../components/LinkPreview.astro';
import ImageLightbox from '../components/ImageLightbox.astro';

interface Props {
  title: string;
  activeTab?: 'home' | 'chapters' | 'almanac';
  showSidebar?: boolean;
  sidebarTitle?: string;
  sidebarItems?: Array<{ label: string; href: string; active?: boolean }>;
  scenario?: string;
}

const base = import.meta.env.BASE_URL;

const { 
  title, 
  activeTab = 'home', 
  showSidebar = false, 
  sidebarTitle = "Navigation", 
  sidebarItems = [],
  scenario: scenarioProp
} = Astro.props;

// Detect scenario from path or props
let currentScenario = scenarioProp ? scenarioProp.toLowerCase() : '';
if (!currentScenario) {
  const path = Astro.url.pathname.toLowerCase();
  if (path.includes('/genesis')) {
    currentScenario = 'genesis';
  } else if (path.includes('/titan')) {
    currentScenario = 'titan';
  }
}

// Retheming based on current scenario
const themeStyles = currentScenario === 'genesis'
  ? '--accent: #ff4d4d; --accent-rgb: 255, 77, 77;'
  : (currentScenario === 'titan'
    ? '--accent: #50b3e6; --accent-rgb: 80, 179, 230;'
    : '');
---

<!doctype html>
<html lang="en" style={themeStyles || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title} | The Portal Threshold</title>
    <meta name="description" content="A serialized story narrative and worldbuilding companion." />
  </head>
  <body class={activeTab === 'home' && !currentScenario ? 'is-root-home' : ''}>
    <div class="site-container">
      <!-- HEADER -->
      <header class="site-header">
        <div class="site-logo">
          <a href={base}>Dani's Backyard</a>
        </div>
        
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href={base} class={activeTab === 'home' ? 'active' : ''}>Home</a>
          <a href={currentScenario ? `${base}/${currentScenario}/chapters` : `${base}/chapters`} class={activeTab === 'chapters' ? 'active' : ''}>Chapters</a>
          <a href={currentScenario ? `${base}/${currentScenario}/almanac` : `${base}/almanac`} class={activeTab === 'almanac' ? 'active' : ''}>Almanac</a>
        </nav>

        <button class="hamburger-btn" id="hamburger-btn" aria-label="Toggle navigation" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </header>

      <!-- NAV PANEL (slide-in mobile drawer) -->
      <div class="nav-backdrop" id="nav-backdrop"></div>
      <nav class="nav-panel" id="nav-panel" aria-label="Mobile navigation">
        <a href={base} class={activeTab === 'home' ? 'active' : ''}>Home</a>
        <a href={currentScenario ? `${base}/${currentScenario}/chapters` : `${base}/chapters`} class={activeTab === 'chapters' ? 'active' : ''}>Chapters</a>
        <a href={currentScenario ? `${base}/${currentScenario}/almanac` : `${base}/almanac`} class={activeTab === 'almanac' ? 'active' : ''}>Almanac</a>
      </nav>

      <!-- MAIN CONTENT WRAPPER -->
      <div class={`main-wrapper ${!showSidebar ? 'no-sidebar' : ''}`}>
        {showSidebar && sidebarItems.length > 0 && (
          <aside class="sidebar">
            <h3>{sidebarTitle}</h3>
            <ul class="sidebar-list">
              {sidebarItems.map(item => (
                <li>
                  <a href={item.href} class={item.active ? 'active' : ''}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}

        <main>
          <slot />
        </main>
      </div>
    </div>

    <LinkPreview />
    <ImageLightbox />

    <script>
      // Hamburger menu toggle
      const hamburgerBtn = document.getElementById('hamburger-btn');
      const navPanel = document.getElementById('nav-panel');
      const navBackdrop = document.getElementById('nav-backdrop');

      function openNav() {
        hamburgerBtn?.classList.add('active');
        navPanel?.classList.add('open');
        navBackdrop?.classList.add('visible');
        hamburgerBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeNav() {
        hamburgerBtn?.classList.remove('active');
        navPanel?.classList.remove('open');
        navBackdrop?.classList.remove('visible');
        hamburgerBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      hamburgerBtn?.addEventListener('click', () => {
        const isOpen = navPanel?.classList.contains('open');
        if (isOpen) {
          closeNav();
        } else {
          openNav();
        }
      });

      navBackdrop?.addEventListener('click', closeNav);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeNav();
      });

      // Mermaid diagram renderer integration
      const mermaidBlocks = document.querySelectorAll('pre.language-mermaid, pre:has(code.language-mermaid)');
      mermaidBlocks.forEach(block => {
        const codeElement = block.querySelector('code');
        const rawCode = codeElement ? codeElement.innerText : (block as HTMLElement).innerText;
        
        const div = document.createElement('div');
        div.className = 'mermaid';
        div.textContent = rawCode;
        block.parentNode?.replaceChild(div, block);
      });
    </script>

    <!-- Load and Initialize Mermaid -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10.2.4/dist/mermaid.min.js"></script>
    <script is:inline>
      if (typeof mermaid !== 'undefined') {
        mermaid.initialize({
          startOnLoad: true,
          theme: 'dark',
          securityLevel: 'loose',
          flowchart: { useMaxWidth: true, htmlLabels: true }
        });
      }
    </script>
  </body>
</html>
