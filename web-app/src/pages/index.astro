---
import MainLayout from '../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL;
---

<MainLayout title="Home" activeTab="home">
  <div class="splitscreen-container">
    <!-- Genesis Split Side -->
    <a href={`${base}/genesis`} class="split-side" id="card-genesis">
      <div class="split-content">
        <h1 class="split-title">Genesis</h1>
        <p class="split-description">
          The Anomaly reconnects. Follow the dual timeline where 1914 Trench Crusade and 2026 Modern Earth collide.
        </p>
        <span class="split-cta">Enter Genesis</span>
      </div>
    </a>

    <!-- Titan Split Side -->
    <a href={`${base}/titan`} class="split-side" id="card-titan">
      <div class="split-content">
        <h1 class="split-title">Titan</h1>
        <p class="split-description">
          The Gate opens in the Yellow Sea. Follow the clash of modern East Asian geopolitics and the dark fantasy of the Attack on Titan world.
        </p>
        <span class="split-cta">Enter Titan</span>
      </div>
    </a>
  </div>
</MainLayout>
