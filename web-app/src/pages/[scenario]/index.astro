---
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  return [
    { params: { scenario: 'genesis' } },
    { params: { scenario: 'titan' } },
  ];
}

const { scenario } = Astro.params;
const base = import.meta.env.BASE_URL;

const metadata = {
  genesis: {
    title: 'Genesis',
    subtitle: 'The Anomaly Reconnects',
    description: 'Follow the dual timeline where 1914 Trench Crusade and 2026 Modern Earth collide.',
    mermaid: `flowchart LR
    subgraph MODERN["Modern Earth"]
        RN["Royal Navy<br/>(Modern)"]
        RAF["RAF Maritime<br/>Patrol"]
    end

    subgraph TC["Trench Crusade Earth"]
        CoE["Crown of<br/>England"]
        SOD["Sacred Order of<br/>the Dragon"]
        HL["Heretic<br/>Legion"]
        BG["Cult of the<br/>Black Grail"]
    end

    ANMLY["The<br/>Anomaly"]

    RN <--> ANMLY
    CoE <--> ANMLY
    RAF --> RN

    CoE --> SOD
    SOD -->|"serves"| CoE
    SOD -->|"enemy"| HL
    CoE -->|"enemy"| HL
    HL -->|"enemy"| SOD
    HL -->|"enemy"| CoE
    BG -->|"serves"| HL
    BG -.->|"Grail-spore"| CoE`
  },
  titan: {
    title: 'Titan',
    subtitle: 'The Gate of the Yellow Sea',
    description: 'Follow the clash of modern East Asian geopolitics and the dark fantasy of the Attack on Titan world.',
    mermaid: `flowchart LR
    subgraph MODERN["Modern Earth"]
        SK["Republic of Korea<br/>Coast Guard"]
        PRC["People's Republic<br/>of China"]
        JPN["Japan"]
        USA["United States"]
    end

    subgraph AOT["AOT World (Inverted Earth)"]
        ELDIA["Eldian Military<br/>(Paradis)"]
        MARLEY["Marleyan<br/>Empire"]
        MIDEAST["Mid-East<br/>Allied Forces"]
        HIZURU["Nation of<br/>Hizuru"]
        WARRIORS["Warrior<br/>Unit"]
        VOLUNTEERS["Anti-Marleyan<br/>Volunteers"]
    end

    PORTAL["The<br/>Gate"]

    SK --> PORTAL
    PRC --> PORTAL
    PORTAL --> MARLEY
    PORTAL --> MIDEAST

    MARLEY --> WARRIORS
    WARRIORS -->|"infiltrate"| ELDIA
    MARLEY -->|"enemy"| MIDEAST
    MIDEAST -->|"enemy"| MARLEY
    HIZURU -->|"alliance"| ELDIA
    VOLUNTEERS -->|"serve"| ELDIA
    MARLEY -->|"subjugates"| ELDIA`
  }
};

const currentMeta = metadata[scenario as 'genesis' | 'titan'];
---

<MainLayout title={currentMeta.title} activeTab="home" scenario={scenario}>
  <a href={base} class="back-link">All Scenarios</a>

  <div class="scenario-hub">
    <!-- Header -->
    <header class="scenario-header">
      <span class="scenario-tag">Scenario Hub</span>
      <h1>{currentMeta.title}</h1>
      <p class="scenario-description">{currentMeta.description}</p>
    </header>

    <!-- Navigation Buttons -->
    <div class="scenario-nav-grid">
      <a href={`${base}/${scenario}/chapters`} class="nav-block">
        <div>
          <div class="nav-block-title">Story Chapters</div>
          <p class="nav-block-description">
            Read through the serialized narrative of the {currentMeta.title} arc.
          </p>
        </div>
        <span class="nav-block-cta">Read Story</span>
      </a>

      <a href={`${base}/${scenario}/almanac`} class="nav-block">
        <div>
          <div class="nav-block-title">Almanac Lore</div>
          <p class="nav-block-description">
            Explore the characters, factions, concepts, items, and locations.
          </p>
        </div>
        <span class="nav-block-cta">Browse Almanac</span>
      </a>
    </div>
  </div>
</MainLayout>
