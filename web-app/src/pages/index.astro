---
import MainLayout from '../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL;
---

<MainLayout title="Home" activeTab="home">
  <div style="padding-top: 20px;">
    <!-- Genesis Hero Card -->
    <a href={`${base}/chapters`} class="hero-card" id="hero-genesis">
      <div class="hero-card-content">
        <span class="hero-card-label">Story Arc</span>
        <h1 class="hero-card-title">Genesis</h1>
        <p class="hero-card-subtitle">
          The Anomaly reconnects. Follow the dual timeline where 1914 Trench Crusade and 2026 Modern Earth collide.
        </p>
      </div>
    </a>

    <!-- Navigation Blocks -->
    <div class="nav-blocks">
      <a href={`${base}/chapters`} class="nav-block" id="nav-story">
        <div>
          <div class="nav-block-title">Story</div>
          <p class="nav-block-description">
            Read through the serialized narrative, chapter by chapter.
          </p>
        </div>
        <span class="nav-block-cta">Browse Chapters</span>
      </a>

      <a href={`${base}/almanac`} class="nav-block" id="nav-almanac">
        <div>
          <div class="nav-block-title">Almanac</div>
          <p class="nav-block-description">
            Explore the encyclopedia of characters, factions, locations, and lore.
          </p>
        </div>
        <span class="nav-block-cta">Open Almanac</span>
      </a>
    </div>
  </div>
</MainLayout>
