---
import '../styles/global.css';
import LinkPreview from '../components/LinkPreview.astro';

interface Props {
  title: string;
  activeTab?: 'home' | 'chapters' | 'almanac';
  showSidebar?: boolean;
  sidebarTitle?: string;
  sidebarItems?: Array<{ label: string; href: string; active?: boolean }>;
}

const base = import.meta.env.BASE_URL;

const { 
  title, 
  activeTab = 'home', 
  showSidebar = false, 
  sidebarTitle = "Navigation", 
  sidebarItems = []
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title} | The Portal Threshold</title>
    <meta name="description" content="A serialized story narrative and worldbuilding companion." />
  </head>
  <body>
    <div class="site-container">
      <!-- HEADER -->
      <header class="site-header">
        <div class="site-logo">
          <a href={base}>The Portal Threshold</a>
        </div>
        <button class="hamburger-btn" id="hamburger-btn" aria-label="Toggle navigation" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </header>

      <!-- NAV PANEL (slide-in) -->
      <div class="nav-backdrop" id="nav-backdrop"></div>
      <nav class="nav-panel" id="nav-panel" aria-label="Main navigation">
        <a href={base} class={activeTab === 'home' ? 'active' : ''}>Home</a>
        <a href={`${base}/chapters`} class={activeTab === 'chapters' ? 'active' : ''}>Chapters</a>
        <a href={`${base}/almanac`} class={activeTab === 'almanac' ? 'active' : ''}>Almanac</a>
      </nav>

      <!-- MAIN CONTENT WRAPPER -->
      <div class={`main-wrapper ${!showSidebar ? 'no-sidebar' : ''}`}>
        {showSidebar && sidebarItems.length > 0 && (
          <aside class="sidebar">
            <h3>{sidebarTitle}</h3>
            <ul class="sidebar-list">
              {sidebarItems.map(item => (
                <li>
                  <a href={item.href} class={item.active ? 'active' : ''}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}

        <main>
          <slot />
        </main>
      </div>
    </div>

    <LinkPreview />

    <script>
      // Hamburger menu toggle
      const hamburgerBtn = document.getElementById('hamburger-btn');
      const navPanel = document.getElementById('nav-panel');
      const navBackdrop = document.getElementById('nav-backdrop');

      function openNav() {
        hamburgerBtn?.classList.add('active');
        navPanel?.classList.add('open');
        navBackdrop?.classList.add('visible');
        hamburgerBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeNav() {
        hamburgerBtn?.classList.remove('active');
        navPanel?.classList.remove('open');
        navBackdrop?.classList.remove('visible');
        hamburgerBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      hamburgerBtn?.addEventListener('click', () => {
        const isOpen = navPanel?.classList.contains('open');
        if (isOpen) {
          closeNav();
        } else {
          openNav();
        }
      });

      navBackdrop?.addEventListener('click', closeNav);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeNav();
      });
    </script>
  </body>
</html>
