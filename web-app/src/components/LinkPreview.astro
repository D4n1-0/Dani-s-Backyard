---
// LinkPreview.astro
// Renders a globally accessible mini-page preview popover for Almanac wiki-links
---

<div id="almanac-preview-popover" class="preview-popover" aria-hidden="true" role="tooltip">
  <!-- Expand Link in Top-Right -->
  <a id="popover-expand-link" href="#" class="popover-expand-button" title="Open Full Entry" aria-label="Open Full Entry">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 3h6v6"></path>
      <path d="M10 14 21 3"></path>
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
    </svg>
  </a>

  <!-- Mini Page Content Area -->
  <div id="popover-body" class="popover-body">
    <div class="popover-loading-wrapper">
      <p class="popover-loading-spinner">Loading...</p>
    </div>
  </div>
</div>

<style>
  /* Link Preview Popover Styles */
  .preview-popover {
    position: absolute;
    top: 0;
    left: 0;
    width: 365px;
    height: 380px;
    max-height: 80vh; /* Limit height on small viewports */
    background-color: var(--bg-secondary);
    backdrop-filter: blur(var(--glass-blur)) saturate(120%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(120%);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: var(--glass-shadow);
    z-index: 9999;
    opacity: 0;
    transform: scale(0.96);
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .preview-popover.visible {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  /* Scrollable Body wrapper */
  .popover-body {
    overflow-y: auto;
    height: 100%;
    padding: 24px;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  /* Custom Webkit scrollbar for mini page */
  .popover-body::-webkit-scrollbar {
    width: 4px;
  }
  .popover-body::-webkit-scrollbar-track {
    background: transparent;
  }
  .popover-body::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
  }
  .popover-body::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }

  /* Popover Expand / Open button */
  .popover-expand-button {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-secondary);
    width: 32px;
    height: 32px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index: 100;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .popover-expand-button:hover {
    background-color: var(--bg-hover);
    color: var(--accent);
    border-color: var(--accent);
    transform: scale(1.05);
  }

  /* Mini page HTML element overrides */
  .popover-body :global(article) {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .popover-body :global(header) {
    display: block !important; /* Force block layout override */
    border-bottom: 1px solid var(--border-color) !important;
    padding-bottom: 12px !important;
    margin-bottom: 16px !important;
    grid-template-columns: none !important;
  }

  .popover-body :global(header span),
  .popover-body :global(header div) {
    font-family: var(--font-ui) !important;
    font-size: 0.65rem !important;
    color: var(--text-muted) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    display: block !important;
    margin-bottom: 6px !important;
  }

  .popover-body :global(h1) {
    font-size: 1.4rem !important;
    line-height: 1.2 !important;
    border-bottom: none !important;
    padding-bottom: 0 !important;
    margin: 0 !important;
    color: var(--accent) !important;
    font-family: var(--font-ui) !important;
    font-weight: 700 !important;
  }

  /* Mini Property Sheet (Info Sheet) */
  .popover-body :global(.info-sheet) {
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
    border: 1px solid var(--border-color) !important;
    border-radius: 8px !important;
    padding: 16px !important;
    margin-bottom: 18px !important;
    background-color: var(--bg-secondary) !important;
    font-size: 0.75rem !important;
  }

  .popover-body :global(.info-row) {
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
    border-bottom: 1px solid var(--border-color) !important;
    padding-bottom: 8px !important;
  }
  .popover-body :global(.info-row:last-child) {
    border-bottom: none !important;
    padding-bottom: 0 !important;
  }

  .popover-body :global(.info-row-label) {
    color: var(--text-muted) !important;
    text-transform: uppercase !important;
    font-size: 0.65rem !important;
    font-weight: 700 !important;
    border-right: none !important;
    border-bottom: none !important;
    background-color: transparent !important;
    padding: 0 !important;
  }

  .popover-body :global(.info-row-value) {
    font-size: 0.8rem !important;
    font-weight: 500 !important;
    color: var(--text-primary) !important;
    border-bottom: none !important;
    padding: 0 !important;
  }

  /* Badges inside property sheet */
  .popover-body :global(.badge) {
    padding: 2px 6px !important;
    font-size: 0.6rem !important;
    margin-right: 4px !important;
    margin-bottom: 4px !important;
    display: inline-block !important;
  }

  /* Inline images within article content */
  .popover-body :global(img) {
    max-width: 100% !important;
    max-height: 140px !important;
    width: 100% !important;
    object-fit: cover !important;
    border: 1px solid var(--border-color) !important;
    margin-bottom: 12px !important;
    opacity: 0.95 !important;
  }

  /* Text elements inside story reader */
  .popover-body :global(.story-reader) {
    font-family: var(--font-reading) !important;
    font-size: 0.95rem !important;
    line-height: 1.6 !important;
    color: var(--text-primary) !important;
  }

  .popover-body :global(.story-reader h1:first-of-type) {
    display: none !important;
  }

  .popover-body :global(.story-reader p) {
    margin-bottom: 0.8rem !important;
    text-align: left !important;
  }

  .popover-body :global(.story-reader p::first-letter) {
    font-family: inherit !important;
    font-size: inherit !important;
    float: none !important;
    margin: 0 !important;
  }

  .popover-body :global(.story-reader h2) {
    font-size: 1.15rem !important;
    margin-top: 1.5rem !important;
    margin-bottom: 0.6rem !important;
    font-family: var(--font-ui) !important;
  }

  .popover-body :global(.story-reader h3) {
    font-size: 1.05rem !important;
    margin-top: 1.2rem !important;
    margin-bottom: 0.5rem !important;
    font-family: var(--font-ui) !important;
  }

  .popover-body :global(ul),
  .popover-body :global(ol) {
    padding-left: 24px !important;
    margin-top: 0.5rem !important;
    margin-bottom: 0.5rem !important;
  }

  .popover-body :global(li) {
    margin-bottom: 4px !important;
  }

  /* loading indicators */
  .popover-loading-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }

  .popover-loading-spinner {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    animation: pulse 1.5s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
</style>

<script>
  // LinkPreview — hover previews for almanac wiki-links
  // Compatible with Astro ClientRouter (View Transitions)
  (function () {
    let popover: HTMLElement | null = null;
    let expandLink: HTMLAnchorElement | null = null;
    let bodyEl: HTMLElement | null = null;

    const cache = new Map();
    const categorySlugs = ['characters', 'factions', 'locations', 'concepts', 'items', 'base', 'timeline'];

    let hoverTimeout: any = null;
    let hideTimeout: any = null;
    let activeTrigger: any = null;
    let abortController: AbortController | null = null;

    function initElements() {
      popover = document.getElementById('almanac-preview-popover');
      expandLink = document.getElementById('popover-expand-link') as HTMLAnchorElement;
      bodyEl = document.getElementById('popover-body');
    }

    // Helper to determine if a link points to an individual Almanac entry
    const isEntryLink = (link: HTMLAnchorElement) => {
      try {
        const url = new URL(link.href, window.location.origin);
        const pathname = url.pathname.replace(/\/$/, '');
        const parts = pathname.split('/');
        const lastPart = parts[parts.length - 1];
        const secondToLast = parts[parts.length - 2];

        if (!pathname.includes('/almanac')) return false;
        if (!lastPart || lastPart === 'almanac') return false;
        if (categorySlugs.includes(lastPart) && secondToLast === 'almanac') return false;

        return true;
      } catch (e) {
        return false;
      }
    };

    const positionPopover = (trigger: HTMLAnchorElement) => {
      if (!popover) return;
      const linkRect = trigger.getBoundingClientRect();
      const popoverWidth = popover.offsetWidth || 365;
      const popoverHeight = popover.offsetHeight || 380;

      let left = linkRect.left + window.scrollX + (linkRect.width - popoverWidth) / 2;
      let top = linkRect.top + window.scrollY - popoverHeight - 12;

      if (linkRect.top - popoverHeight - 12 < 10) {
        top = linkRect.top + window.scrollY + linkRect.height + 12;
      }

      const minLeft = 10 + window.scrollX;
      const maxLeft = window.innerWidth + window.scrollX - popoverWidth - 10;
      if (left < minLeft) left = minLeft;
      if (left > maxLeft) left = maxLeft;

      popover.style.left = `${left}px`;
      popover.style.top = `${top}px`;
    };

    const showPopover = async (trigger: HTMLAnchorElement) => {
      if (!popover || !bodyEl) return;
      if (abortController) abortController.abort();

      activeTrigger = trigger;
      popover.setAttribute('aria-hidden', 'false');
      popover.classList.add('visible');

      bodyEl.scrollTop = 0;
      bodyEl.innerHTML = `
        <div class="popover-loading-wrapper">
          <p class="popover-loading-spinner">Loading...</p>
        </div>
      `;

      requestAnimationFrame(() => positionPopover(trigger));

      const targetUrl = trigger.href;
      if (expandLink) expandLink.href = targetUrl;

      if (cache.has(targetUrl)) {
        if (bodyEl && activeTrigger === trigger) {
          bodyEl.innerHTML = cache.get(targetUrl);
          requestAnimationFrame(() => positionPopover(trigger));
        }
        return;
      }

      try {
        abortController = new AbortController();
        const response = await fetch(targetUrl, { signal: abortController.signal });
        if (!response.ok) throw new Error('Failed to load');

        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const article = doc.querySelector('article');
        const contentHTML = article ? article.innerHTML : '<p>Error: Could not extract entry content.</p>';

        cache.set(targetUrl, contentHTML);

        if (activeTrigger === trigger && bodyEl) {
          bodyEl.innerHTML = contentHTML;
          requestAnimationFrame(() => positionPopover(trigger));
        }
      } catch (err: any) {
        if (err.name !== 'AbortError' && activeTrigger === trigger && bodyEl) {
          bodyEl.innerHTML = `
            <div style="padding: 10px 0;">
              <h3 style="color: var(--accent); font-family: var(--font-heading); margin-bottom: 10px;">Error Loading Entry</h3>
              <p>Failed to retrieve content for this record. The link may be broken or the server is offline.</p>
            </div>
          `;
          requestAnimationFrame(() => positionPopover(trigger));
        }
      }
    };

    const hidePopover = () => {
      if (abortController) {
        abortController.abort();
        abortController = null;
      }
      activeTrigger = null;
      if (popover) {
        popover.classList.remove('visible');
        popover.setAttribute('aria-hidden', 'true');
      }
    };

    const setupListeners = () => {
      initElements();
      if (!popover) return;

      const links = document.querySelectorAll('.story-reader a') as NodeListOf<HTMLAnchorElement>;

      links.forEach(link => {
        if (!isEntryLink(link)) return;

        link.addEventListener('mouseenter', () => {
          if (window.matchMedia('(hover: none)').matches) return;
          clearTimeout(hideTimeout);
          clearTimeout(hoverTimeout);
          hoverTimeout = setTimeout(() => showPopover(link), 200);
        });

        link.addEventListener('mouseleave', () => {
          if (window.matchMedia('(hover: none)').matches) return;
          clearTimeout(hoverTimeout);
          hideTimeout = setTimeout(() => hidePopover(), 300);
        });

        link.addEventListener('click', (e) => {
          if (!window.matchMedia('(hover: none)').matches) return;
          const isVisible = popover?.classList.contains('visible') && activeTrigger === link;
          if (!isVisible) {
            e.preventDefault();
            e.stopPropagation();
            showPopover(link);
          }
        });
      });

      // Keep popover open while mouse is inside it
      popover.addEventListener('mouseenter', () => clearTimeout(hideTimeout));
      popover.addEventListener('mouseleave', () => {
        if (window.matchMedia('(hover: none)').matches) return;
        hideTimeout = setTimeout(() => hidePopover(), 300);
      });
    };

    // Global dismiss handlers (bound once)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hidePopover();
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (popover?.classList.contains('visible') && !popover.contains(target) && target !== activeTrigger) {
        hidePopover();
      }
    });

    // Initialize on first load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupListeners);
    } else {
      setupListeners();
    }

    // Re-initialize after every View Transition swap
    document.addEventListener('astro:after-swap', setupListeners);
  })();
</script>
